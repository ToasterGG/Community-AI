<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Sprout – the community AI that starts empty</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 36 36'%3E%3Ctext y='30' font-size='30'%3E🌱%3C/text%3E%3C/svg%3E">
<style>
:root{--lift:56px;color-scheme:light dark;--bg:#eef3f0;--panel:#fff;--soft:#e0eae4;--ink:#14211b;--mut:#5a6b61;--leaf:#1f8a55;--soil:#8a6a50;--line:#d3ddd7;--on:#fff}
@media(prefers-color-scheme:dark){:root{--bg:#0e1612;--panel:#16211b;--soft:#1c2b23;--ink:#e3efe8;--mut:#8ea397;--leaf:#4cc084;--soil:#a98a6e;--line:#27382e;--on:#04120a}}
@media(hover:hover) and (pointer:fine){:root{--lift:28px}}
*{box-sizing:border-box}
[hidden]{display:none!important}
html{height:100%}
body{margin:0 auto;height:100%;height:100dvh;background:var(--bg);color:var(--ink);font:16px/1.55 system-ui,-apple-system,"Segoe UI",sans-serif;display:flex;flex-direction:column;max-width:720px}
header{display:flex;align-items:center;gap:12px;padding:max(12px,env(safe-area-inset-top)) 16px 12px}
#plant{width:36px;height:44px;padding:8px;box-sizing:content-box;background:var(--soft);border-radius:16px;flex:none}
h1,h2,h3{font-family:"Avenir Next","Trebuchet MS",system-ui,sans-serif;letter-spacing:-.015em}
h1{margin:0;font-size:27px;line-height:1}
h1 small{display:block;font:400 12.5px/1.3 system-ui;color:var(--mut);letter-spacing:0;margin-top:5px}
h2{margin:0 0 4px;font-size:20px}
h3{margin:0 0 10px;font-size:17px}
.sp{flex:1}
button,.btn{font:600 14px system-ui;border:1px solid var(--line);background:var(--panel);color:var(--ink);border-radius:10px;padding:9px 14px;cursor:pointer;transition:filter .15s}
button:hover,.btn:hover{filter:brightness(.96)}
button.pri{background:var(--leaf);border-color:var(--leaf);color:var(--on)}
:focus-visible{outline:2px solid var(--leaf);outline-offset:2px}
#pill{border-radius:999px;background:var(--soft);border-color:transparent;color:var(--mut);font-weight:500;font-size:12.5px;padding:7px 12px}
nav{display:flex;gap:4px;margin:0 14px 8px;padding:4px;background:var(--soft);border-radius:12px}
nav button{flex:1;border:0;border-radius:9px;background:none;padding:9px;color:var(--mut)}
nav button[aria-selected=true]{background:var(--panel);color:var(--ink);box-shadow:0 1px 3px rgba(0,0,0,.14)}
#chat{flex:1;min-height:0;display:flex;flex-direction:column}
#log{flex:1;overflow-y:auto;padding:8px 14px 12px;display:flex;flex-direction:column;gap:10px}
.m{max-width:86%;padding:10px 14px;border-radius:16px;white-space:pre-wrap;overflow-wrap:anywhere;animation:in .2s ease-out}
.bot{align-self:flex-start;background:var(--panel);border:1px solid var(--line);border-bottom-left-radius:4px}
.me{align-self:flex-end;background:var(--leaf);color:var(--on);border-bottom-right-radius:4px}
.m button{margin-top:8px}
.note{margin-top:8px;padding-top:8px;border-top:1px dashed var(--line);font-size:12.5px;color:var(--mut)}
.tout{font-size:18px;line-height:1.5;padding:12px 14px;margin:10px 0;background:var(--bg);border-radius:10px;min-height:3em;overflow-wrap:anywhere}
#tinfo{white-space:pre-line}
.opt{display:flex;justify-content:space-between;align-items:center;gap:10px;width:100%;margin:4px 0;text-align:left;font-weight:400;padding:7px 12px;border-radius:8px}
.opt b{font-weight:600}.opt small{color:var(--mut);font-size:12px}
.opt.out{opacity:.5}
.typing{display:flex;gap:5px;padding:15px 16px}
.typing i{width:7px;height:7px;border-radius:50%;background:var(--mut);opacity:.4;animation:dot 1s infinite}
.typing i:nth-child(2){animation-delay:.15s}.typing i:nth-child(3){animation-delay:.3s}
@keyframes dot{50%{opacity:1;transform:translateY(-3px)}}
@keyframes in{from{opacity:0;transform:translateY(5px)}}
@media(prefers-reduced-motion:reduce){.m,.typing i{animation:none}}
.dock{padding:4px 12px calc(var(--lift) + env(safe-area-inset-bottom))}
.tune{display:flex;align-items:center;gap:8px;padding:0 8px 8px;font-size:12px;color:var(--mut)}
.tune input{flex:1;accent-color:var(--leaf)}
.bar{display:flex;gap:8px;align-items:flex-end;background:var(--panel);border:1px solid var(--line);border-radius:26px;padding:6px 6px 6px 18px;box-shadow:0 4px 16px rgba(20,40,30,.09)}
.bar:focus-within{border-color:var(--leaf)}
textarea,input[type=password],input[type=text]{font:16px/1.4 system-ui;padding:10px 12px;border:1px solid var(--line);border-radius:10px;background:var(--bg);color:var(--ink)}
#in{flex:1;border:0;border-radius:0;background:none;outline:none;resize:none;padding:9px 0;max-height:120px}
#go{width:42px;height:42px;padding:0;border-radius:50%;display:grid;place-items:center;flex:none}
#teach{flex:1;overflow-y:auto;padding:4px 14px calc(28px + env(safe-area-inset-bottom))}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.stats div{background:var(--soft);border-radius:12px;padding:10px 12px;font-size:12.5px;color:var(--mut)}
.stats b{display:block;font:700 22px "Avenir Next","Trebuchet MS",system-ui,sans-serif;color:var(--ink)}
#teach section{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:16px;margin-top:12px}
#txt{width:100%;resize:vertical;margin:8px 0}
#tok,#tp{flex:1 1 220px}
.row{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin:8px 0}
.hint{font-size:13px;color:var(--mut);margin:6px 0}
ul{list-style:none;padding:0;margin:0}
li{display:flex;gap:10px;align-items:flex-start;justify-content:space-between;padding:9px 0;border-bottom:1px solid var(--line);font-size:14px;overflow-wrap:anywhere}
li:last-child{border-bottom:0}
li button{flex:none;padding:4px 10px;font-size:12.5px}
</style>
</head>
<body>
<header>
  <svg id="plant" viewBox="0 0 36 44" aria-hidden="true"></svg>
  <h1>Sprout<small>Starts empty. Learns from you and everyone else.</small></h1>
  <span class="sp"></span>
  <button id="pill" title="Re-sync the community model">…</button>
</header>
<nav role="tablist">
  <button role="tab" id="t-chat" aria-selected="true">Chat</button>
  <button role="tab" id="t-teach" aria-selected="false">Teach</button>
</nav>

<main id="chat">
  <div id="log" aria-live="polite"></div>
  <div class="dock">
    <div class="tune"><span>Focused</span><input id="temp" type="range" min="0.3" max="1.6" step="0.1" value="0.8" aria-label="Creativity"><span>Creative</span></div>
    <div class="bar">
      <textarea id="in" rows="1" placeholder="Ask me something"></textarea>
      <button id="go" class="pri" aria-label="Send"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"/></svg></button>
    </div>
  </div>
</main>

<main id="teach" hidden>
  <div class="stats"><div><b id="s1">0</b>facts</div><div><b id="s2">0</b>words</div><div><b id="s3">0</b>patterns</div></div>
  <section>
  <h2>Teach Sprout</h2>
  <p class="hint">Paste text or write one fact per line. Write "question => answer" to give a direct answer. Teach something more than once and Sprout becomes surer of it.</p>
  <textarea id="txt" rows="6" placeholder="The capital of France is Paris.&#10;What is a sprout? => A young plant that has just started to grow."></textarea>
  <div class="row">
    <button id="learn" class="pri">Teach</button>
    <label class="btn" for="fi">Add .txt files</label>
    <input id="fi" type="file" accept=".txt,text/plain" multiple hidden>
    <span id="msg" class="hint" aria-live="polite"></span>
  </div>
  </section>

  <section>
    <h3>Test the predictor</h3>
    <p class="hint">Watch Sprout write one word at a time, using the creativity slider from Chat. Sprout only picks from the top 3 to 5 words (more at higher creativity); faded options are outside that pool. Tap any option to force it. Tags: topic = relates to your prompt, repeat = used recently so less likely, follows fact = continues the best matching fact.</p>
    <div class="row"><input id="tp" type="text" placeholder="Prompt, for example: What is a sprout?"><button id="tstart" class="pri">Start</button></div>
    <div id="tview" hidden>
      <div id="tout" class="tout" aria-live="polite"></div>
      <p id="tinfo" class="hint"></p>
      <div id="topts"></div>
      <div class="row"><button id="tstep" class="pri">Step</button><button id="tauto">Auto</button><button id="tfin">Finish</button></div>
    </div>
  </section>

  <section>
    <h3>Share with everyone</h3>
    <p class="hint">Sprout only reads and writes <b>model.json</b> on the <b>main</b> branch of ToasterGG/Community-AI, and nothing else.</p>
    <div class="row">
      <input id="tok" type="password" placeholder="GitHub token with Contents: read and write" autocomplete="off">
      <label class="hint"><input type="checkbox" id="rem"> Remember on this device</label>
    </div>
    <div class="row">
      <button id="sv">Save token</button><button id="cl">Remove token</button><button id="up" class="pri">Share</button>
    </div>
    <p id="sst" class="hint" aria-live="polite"></p>
    <p class="hint">The token stays in this browser and is only sent to api.github.com. It needs write access to ToasterGG/Community-AI.</p>
  </section>

  <section>
    <h3>Your unshared lessons</h3>
    <ul id="mine"></ul>
  </section>
</main>

<script>
const REPO='ToasterGG/Community-AI',FILE='model.json',BRANCH='main',API=put=>`https://api.github.com/repos/${REPO}/contents/${FILE}`+(put?'':`?ref=${BRANCH}`);
const $=s=>document.querySelector(s),log=$('#log'),inp=$('#in');
const S=(o,k,v)=>{try{return v===undefined?o.getItem(k):v===null?o.removeItem(k):o.setItem(k,v)}catch{}};
const token=()=>S(sessionStorage,'sprout.tk')||S(localStorage,'sprout.tk')||'';
const STOP=new Set('a an the is are was were be been am of to in on at for and or but with by as it its this that these those i you he she we they me my your do does did what who when where why how which can could will would should about into from than then so if not no yes tell explain more please also there'.split(' '));
const stem=w=>{const r=w.replace(/(ing|ed|es|s)$/,'');return r.length>2?r:w};
const tok=s=>(s.toLowerCase().match(/[\p{L}\p{N}]+/gu)||[]).filter(w=>(w.length>1||/\p{N}/u.test(w))&&!STOP.has(w)).map(stem),rawtok=s=>(s.toLowerCase().match(/[\p{L}\p{N}]+/gu)||[]).map(stem);
const WD=/[\p{L}\p{N}]+(?:['’-][\p{L}\p{N}]+)*|[.,!?;:]/gu;
const norm=f=>f&&typeof f.t==='string'&&f.t.trim()&&f.t.length<=500?{t:f.t.trim(),...(typeof f.q==='string'&&f.q.trim()&&f.q.length<=300?{q:f.q.trim()}:{}),...(Number.isInteger(f.c)&&f.c>1?{c:Math.min(f.c,100000)}:{})}:null;
const key=f=>((f.q||'')+'|'+f.t).toLowerCase().replace(/\s+/g,' ').trim();
const b64e=s=>{const b=new TextEncoder().encode(s);let o='';for(let i=0;i<b.length;i+=8192)o+=String.fromCharCode(...b.subarray(i,i+8192));return btoa(o)};
const b64d=s=>new TextDecoder().decode(Uint8Array.from(atob(s.replace(/\s/g,'')),c=>c.charCodeAt(0)));
const nul=()=>Object.create(null);
let comm=[],mine=[],idx={N:0,docs:[],df:nul()},M={T:nul(),B:nul(),Q:nul(),cs:nul()};
try{mine=JSON.parse(S(localStorage,'sprout.mine')||'[]').map(norm).filter(Boolean)}catch{}
const persist=()=>{try{localStorage.setItem('sprout.mine',JSON.stringify(mine))}catch{sst('This browser has no room left to keep your lessons, so share them to GitHub soon.')}};
const tmsg=t=>$('#msg').textContent=t,sst=t=>$('#sst').textContent=t;
const msgL=(n,r)=>n||r?`Learned ${n} new thing${n==1?'':'s'}${r?` and reinforced ${r} I already knew`:''}.`:'I could not find anything to learn there.';
let BADSNIP='';
const HTMLMSG="GitHub answered with a web page instead of data. A school or work network filter, or a proxy, is probably blocking api.github.com. Try another network or a phone hotspot.";
async function jget(r){const t=await r.text();try{return JSON.parse(t)}catch{throw 'html'}}

function say(t,w='bot',act,note){const d=document.createElement('div');d.className='m '+w;d.textContent=t;
  if(note){const n=document.createElement('div');n.className='note';n.textContent=note;d.append(n)}
  if(act){const b=document.createElement('button');b.textContent=act[0];b.onclick=act[1];d.append(document.createElement('br'),b)}
  log.append(d);log.scrollTop=log.scrollHeight;return d}
function show(t){['chat','teach'].forEach(x=>{$('#'+x).hidden=x!=t;$('#t-'+x).setAttribute('aria-selected',x==t)});if(t=='chat')inp.focus()}
function plant(n){const L=Math.min(7,Math.floor(Math.log2(n+1)));let s='<rect x="10" y="36" width="16" height="8" rx="2" fill="var(--soil)"/>';
  if(!L)s+='<circle cx="18" cy="34" r="2.5" fill="var(--leaf)"/>';
  else{s+=`<path d="M18 36V${36-(8+L*4)}" stroke="var(--leaf)" stroke-width="2" fill="none"/>`;
    for(let i=0;i<L;i++){const y=31-i*4,r=i%2?1:-1,x=18+r*5;s+=`<ellipse cx="${x}" cy="${y}" rx="5" ry="2.4" transform="rotate(${-r*25} ${x} ${y})" fill="var(--leaf)"/>`}}
  $('#plant').innerHTML=s}

/* Learning: every fact is indexed for retrieval AND counted into word-pattern tables
   (T = which word follows the last two words, B = which word follows the last word,
   cs = how each word is usually capitalised). */
function build(){const mp=new Map(),docs=[],df=nul(),T=nul(),B=nul(),Q=nul(),cs=nul();
  const inc=(m,k,w,n)=>{const o=m[k]||(m[k]=nul());o[w]=(o[w]||0)+n};
  [...comm,...mine].forEach(f=>{const k=key(f),e=mp.get(k);e?e.c+=f.c||1:mp.set(k,{...f,c:f.c||1})});
  [...mp.values()].forEach(f=>{
    const tk=tok((f.q||'')+' '+f.t),set=new Set(tk);set.forEach(w=>df[w]=(df[w]||0)+1);docs.push({f,set,n:tk.length,qa:new Set(rawtok(f.q||'')),qs:new Set(tok(f.q||'')),bg:new Set(tk.slice(1).map((x,i)=>tk[i]+' '+x))});
    const raw=f.t.match(WD)||[],a=['<s>','<s>','<s>',...raw.map(x=>x.toLowerCase()),'</s>'];
    raw.forEach((x,i)=>{if(i&&/\p{L}/u.test(x))inc(cs,x.toLowerCase(),x,f.c)});
    for(let i=3;i<a.length;i++){inc(Q,a[i-3]+' '+a[i-2]+' '+a[i-1],a[i],f.c);inc(T,a[i-2]+' '+a[i-1],a[i],f.c);inc(B,a[i-1],a[i],f.c)}});
  idx={N:docs.length,docs,df};M={T,B,Q,cs};plant(idx.N);
  $('#pill').textContent=`${comm.length} shared · ${mine.length} yours`;
  $('#up').textContent=mine.length?`Share ${mine.length} lesson${mine.length>1?'s':''}`:'Share';
  $('#s1').textContent=idx.N;$('#s2').textContent=Math.max(0,Object.keys(B).length-1);$('#s3').textContent=Object.keys(T).length;
  const ul=$('#mine');ul.innerHTML='';
  mine.slice(-40).reverse().forEach(f=>{const li=document.createElement('li'),s=document.createElement('span'),b=document.createElement('button');
    s.textContent=(f.q?f.q+' => ':'')+f.t+(f.c>1?'  ×'+f.c:'');b.textContent='Remove';b.onclick=()=>{mine=mine.filter(x=>x!==f);persist();build()};li.append(s,b);ul.append(li)});
  if(!mine.length){const li=document.createElement('li');li.textContent='Nothing yet. What you teach appears here until you share it.';ul.append(li)}}
function add(items){const mi=new Map(mine.map(x=>[key(x),x])),ci=new Set(comm.map(key));let n=0,r=0;
  items.forEach(f=>{f=norm(f);if(!f)return;const k=key(f),e=mi.get(k);
    if(e){e.c=(e.c||1)+(f.c||1);r++}else{mine.push(f);mi.set(k,f);ci.has(k)?r++:n++}});
  persist();build();return[n,r]}
const chunks=(t,min)=>t.split(/(?<=[.!?])\s+/).map(s=>s.trim().replace(/\s+/g,' ')).filter(s=>s.length>=min).map(s=>({t:s.slice(0,500)}));
const parse=(t,min)=>t.replace(/\r/g,'').split('\n').flatMap(l=>{const m=l.split(/\s*=>\s*/);return m.length==2&&m[0].trim()&&m[1].trim()?[{q:m[0].trim(),t:m[1].trim()}]:chunks(l,min)});

/* Recall: find the facts most relevant to the prompt. */
let HIST=[],USED=new Set();
const uniq=r=>{const s=new Set();return r.filter(x=>!s.has(x.t)&&s.add(x.t))};
const near=(a,b)=>{const x=new Set(tok(a)),y=new Set(tok(b));let i=0;x.forEach(t=>y.has(t)&&i++);return i/(x.size+y.size-i||1)>.6};
function ctxMap(){const m=new Map();HIST.slice(-3).reverse().forEach((h,i)=>[...tok(h.q),...tok(h.a)].forEach(w=>m.set(w,Math.max(m.get(w)||0,[.5,.3,.2][i]))));return m}
function ask(q,loose){
  if(!idx.N)return[];
  const tq=tok(q),ctx=ctxMap();let qt=[...new Set(tq)],cont=false;
  if(!qt.length){
    const qr=new Set(rawtok(q));
    if(qr.size){const r=idx.docs.filter(d=>d.qa.size).map(d=>{let i=0;qr.forEach(t=>{if(d.qa.has(t))i++});const j=i/(qr.size+d.qa.size-i);return{t:d.f.t,cov:j,qc:1,r:j}}).filter(x=>x.cov>=.6).sort((a,b)=>b.r-a.r);
      if(r.length)return uniq(r.filter(x=>x.cov>=r[0].cov-.1)).slice(0,3)}
    if(!ctx.size)return[];qt=[...ctx.keys()];cont=true}
  const w=t=>Math.log(1+idx.N/(1+(idx.df[t]||0))),qw=t=>cont?ctx.get(t):1,tot=qt.reduce((a,t)=>a+w(t)*qw(t),0),
    ctot=[...ctx.keys()].reduce((a,t)=>a+w(t)*ctx.get(t),0)||1,qb=tq.slice(1).map((x,i)=>tq[i]+' '+x);
  let r=idx.docs.map(d=>{let m=0,mq=0,mc=0;qt.forEach(t=>{const x=w(t)*qw(t);if(d.set.has(t))m+=x;if(d.qs.has(t))mq+=x});
    if(!cont)ctx.forEach((v,t)=>{if(d.set.has(t))mc+=w(t)*v});
    const cov=m/tot,bg=qb.length?qb.filter(b=>d.bg.has(b)).length/qb.length:0;
    let s=(cov+.5*bg)*m/Math.sqrt(d.n+3)*(1+2*mq/tot)*(1+.3*Math.log2(d.f.c))*(1+mc/ctot);
    if(cont&&USED.has(d.f.t))s*=.2;
    return{t:d.f.t,cov,qc:mq/tot,r:s}}).filter(x=>x.cov>(loose?0:cont?.15:.49)).sort((a,b)=>b.r-a.r);
  r=uniq(r);return r.length?r.filter(x=>x.r>=r[0].r*.5).slice(0,3):[]}

/* Reply: write one word at a time.
   - Memory: the next word comes from what followed the last 3 words (then 2, then 1) in everything Sprout has read.
   - Focus: words related to the prompt are boosted, and Sprout follows the best-matching fact as a template,
     moving on to a second matching fact if the first is short.
   - Choice: only the top 3-5 candidates are eligible (more at higher creativity), picked by chance.
   gstate/gopts/gpush are single steps, so the Teach menu can replay them live. */
const pick=(a,f)=>{let r=Math.random()*a.reduce((s,x)=>s+f(x),0);for(const x of a){r-=f(x);if(r<=0)return x}return a[a.length-1]};
const sc=nul(),sk=w=>sc[w]??(sc[w]=tok(w)[0]||''),draw=o=>pick(o.filter(x=>x.pool),x=>x.x);
function setsrc(st){const h=st.hits[st.hi];st.src=h?(h.t.match(WD)||[]).map(x=>x.toLowerCase()):null;st.pos=st.src?0:-1}
function gstate(q,Tp){
  let hits=ask(q),guessed=false;if(!hits.length){guessed=true;hits=ask(q,true)}
  const topic=new Map(),up=(w,v)=>topic.set(w,(topic.get(w)||0)+v);
  tok(q).forEach(w=>up(w,3));ctxMap().forEach((v,w)=>up(w,v*2));hits.forEach((h,i)=>tok(h.t).forEach(w=>up(w,i?1:2)));
  if(hits.length>1){const f=pick(hits.filter(h=>h.r>=hits[0].r*.8),()=>1);hits=[f,...hits.filter(h=>h!==f)]}
  hits=hits.filter((h,i)=>i==0||h.r>=hits[0].r*.7).filter((h,i)=>!hits.slice(0,i).some(g=>near(g.t,h.t)));
  const st={hits,guessed,topic,Tp,hi:0,h:['<s>','<s>','<s>'],out:[],sent:0,done:false};setsrc(st);return st}
function gopts(st){
  const drop=Math.random()<Math.max(0,(st.Tp-.7)*.5),H=st.h,k4=H.join(' '),k3=H.slice(1).join(' '),
    c=!drop&&M.Q[k4]?[M.Q[k4],'4-word']:M.T[k3]?[M.T[k3],'3-word']:M.B[H[2]]?[M.B[H[2]],'2-word']:null;
  if(!c)return[];
  const cand=c[0],recent=st.out.slice(-8),hh=st.hits[st.hi],pf=st.guessed?.3:hh&&hh.qc>=.8?(st.Tp>1.2?.96:.999):.97,
    nx=st.src&&st.pos>=0?(st.pos<st.src.length?st.src[st.pos]:'</s>'):null,keys=new Set(Object.keys(cand));
  if(nx)keys.add(nx);
  const o=[...keys].filter(w=>w!='</s>'||st.out.length).map(w=>{
    let x=Math.pow(cand[w]||.5,1/st.Tp);const tags=[],t=st.topic.get(sk(w));
    if(t){x*=1+Math.min(t,6)*1.5;tags.push('topic')}
    if(sk(w)&&recent.includes(w)){x*=.15;tags.push('repeat')}
    if(w=='</s>'&&st.out.length<6&&w!==nx){x*=.05;tags.push('too early')}
    return{w,x,n:cand[w]||0,tags,mode:c[1]}});
  if(nx){const e=o.find(b=>b.w===nx);if(e){const rest=o.reduce((a,b)=>b===e?a:a+b.x,0);e.x=rest>0?rest*pf/(1-pf):1;e.tags.push('follows fact')}}
  const tot=o.reduce((a,b)=>a+b.x,0);o.forEach(b=>b.p=b.x/tot);o.sort((a,b)=>b.x-a.x);
  const k=Math.round(3+2*Math.min(1,Math.max(0,(st.Tp-.3)/1.3)));o.forEach((b,i)=>b.pool=i<k);return o}
function gpush(st,w){
  if(w=='</s>'){if(!st.out.length)return;if(!/[.!?]$/.test(st.out[st.out.length-1]))st.out.push('.');st.h=['<s>','<s>','<s>'];st.sent++;
    if(st.sent>=2||st.out.length>=25||st.guessed||!st.hits[st.hi+1]||st.hits[st.hi].qc>=.8)st.done=true;else{st.hi++;setsrc(st)}return}
  if(st.src&&st.pos>=0){if(st.src[st.pos]===w)st.pos++;else{const j=st.src.indexOf(w);st.pos=j<0?-1:j+1}}
  st.out.push(w);st.h=[...st.h.slice(1),w];if(st.out.length>=60)st.done=true}
function fmt(out,final){const form=w=>{const c=M.cs[w];return c?Object.keys(c).reduce((a,b)=>c[b]>c[a]?b:a):w};
  let t=out.map(form).join(' ').replace(/ ([.,!?;:])/g,'$1').replace(/\bi\b/g,'I').replace(/(^|[.!?] )(\p{Ll})/gu,(m,a,b)=>a+b.toUpperCase());
  return final?t.replace(/([^.!?])$/,'$1.'):t}
function gen(q,Tp){if(!idx.N)return null;const st=gstate(q,Tp);
  for(let n=0;n<200&&!st.done;n++){const o=gopts(st);if(!o.length)break;gpush(st,draw(o).w)}
  const res=st.out.length?{text:fmt(st.out,true),guessed:st.guessed}:st.hits.length?{text:st.hits[0].t,guessed:st.guessed}:null;
  if(res){HIST=[...HIST,{q,a:res.guessed?'':res.text}].slice(-6);if(!res.guessed)USED=new Set([...USED,...st.hits.slice(0,st.hi+1).map(h=>h.t)].slice(-20))}
  return res}

async function load(){
  $('#pill').textContent='syncing…';
  try{const h={Accept:'application/vnd.github.raw+json'};if(token())h.Authorization='Bearer '+token();
    const r=await fetch(API(),{headers:h});
    if(r.status==404)comm=[];
    else if(r.ok){const m=await jget(r);comm=(m.facts||[]).map(norm).filter(Boolean)}
    else throw r.status;
    sst('')}catch(e){sst(e=='html'?"I couldn't read the community model. Either a network filter is blocking GitHub or model.json on main isn't Sprout data. Sharing will tell you which.":"I couldn't reach the community model, so I'm using only what I have locally. Tap the counter at the top to retry.")}
  build()}

async function upload(){
  const t=token();
  if(!t){$('#tok').focus();return sst('Paste a GitHub token above and save it first.')}
  if(!mine.length)return sst('There is nothing new to share yet. Teach me something first.');
  sst('Sharing with the community…');
  try{for(let i=0;i<3;i++){
    const H={Accept:'application/vnd.github+json',Authorization:'Bearer '+t};
    let sha,cur=[];const g=await fetch(API(),{headers:H});
    if(g.ok){const j=await jget(g);if(j.path!==FILE||j.type!=='file')throw 'wrong';sha=j.sha;const txt=j.content?b64d(j.content):await(await fetch(j.download_url)).text();try{if(txt.trim()){const o=JSON.parse(txt);if(!Array.isArray(o.facts))throw 0;cur=o.facts.map(norm).filter(Boolean)}}catch{BADSNIP=txt.trim().slice(0,50);throw 'bad'}}
    else if(g.status!=404)throw g.status;
    const tot=mine.length,mp=new Map(cur.map(f=>[key(f),{...f}]));let nn=0;
    mine.forEach(f=>{const k=key(f),e=mp.get(k);if(e)e.c=(e.c||1)+(f.c||1);else{mp.set(k,{...f});nn++}});
    const merged=[...mp.values()];
    const p=await fetch(API(1),{method:'PUT',headers:{...H,'Content-Type':'application/json'},body:JSON.stringify({message:`Sprout: +${nn} new, ${tot-nn} reinforced`,content:b64e(JSON.stringify({v:1,name:'Sprout',facts:merged})),sha,branch:BRANCH})});
    if(p.ok){comm=merged;mine=[];persist();build();return sst(`Shared ${nn} new thing${nn==1?'':'s'}${tot-nn?` and reinforced ${tot-nn}`:''}. Everyone gets them the next time they open me.`)}
    if(p.status!=409&&p.status!=422)throw p.status}
    throw 409
  }catch(e){sst(e=='html'?HTMLMSG:e=='wrong'?`GitHub returned something other than ${FILE} on ${BRANCH}, so I stopped without writing anything.`:e=='bad'?`${FILE} on ${BRANCH} isn't Sprout data (it starts with "${BADSNIP}"), so I haven't touched it. If that file is your app's page, move the page to another file name and leave ${FILE} for Sprout.`:e==401?'GitHub rejected the token. Check that it is correct and has not expired.':e==403||e==404?`That token cannot write to ${REPO}. It needs access to that repository with Contents: read and write.`:e instanceof TypeError?"I couldn't reach GitHub. Check your connection or any network filter, then try again.":`Sharing failed (${e}). Your lessons are still saved here, so try again in a moment.`)}}

function send(){const v=inp.value.trim();if(!v)return;inp.value='';inp.style.height='auto';say(v,'me');
  const t=say('','bot typing');t.innerHTML='<i></i><i></i><i></i>';
  setTimeout(()=>{t.remove();const g=gen(v,+$('#temp').value),tm=['Teach me the real answer',()=>{$('#txt').value=v+' => ';show('teach');$('#txt').focus()}];
    if(g)return say(g.text,'bot',g.guessed?tm:null,g.guessed?'This response had guesses included.':null);
    say("My mind is a blank page, so I have nothing to say yet.",'bot',['Open Teach',()=>show('teach')])},350+Math.random()*350)}
async function files(list){show('teach');let n=0,r=0,k=0;tmsg('Reading…');
  for(const f of list)if(/\.txt$/i.test(f.name)||f.type=='text/plain'){const [a,b]=add(parse(await f.text(),12));n+=a;r+=b;k++}
  tmsg(k?`Read ${k} file${k>1?'s':''}. `+msgL(n,r):'I can only read .txt files.')}

/* Test panel: replay generation one word at a time */
let TS=null,tim=null;
function tshow(){const st=TS,o=st.opts||[],ctx=st.h.filter(x=>x!='<s>').join(' ');
  $('#tout').textContent=st.out.length?fmt(st.out,st.done):'(nothing yet)';
  $('#tinfo').textContent=(st.msg?st.msg+'\n':'')+(st.done?'Finished. Press Start to try again.':o.length?`Next word after ${ctx?'"'+ctx+'"':'the start of a sentence'}: ${o[0].mode} pattern, ${o.length} candidate${o.length>1?'s':''}, ${o.filter(x=>x.pool).length} in the pool, top ${Math.min(10,o.length)} shown.`+(st.guessed?'\nNo strong match for this prompt, so Sprout is guessing.':''):'There is no pattern to continue from.');
  const box=$('#topts');box.innerHTML='';
  if(!st.done)o.slice(0,10).forEach(c=>{const b=document.createElement('button'),l=document.createElement('span'),w=document.createElement('b'),d=document.createElement('small'),p=document.createElement('span'),pc=c.p*100;
    b.className='opt'+(c.pool?'':' out');b.style.backgroundImage=`linear-gradient(90deg,var(--soft) ${pc}%,transparent ${pc}%)`;
    w.textContent=c.w=='</s>'?'(end of sentence)':c.w;d.textContent=`seen ${c.n}×`+(c.tags.length?' · '+c.tags.join(', '):'');
    l.append(w,document.createElement('br'),d);p.textContent=pc.toFixed(1)+'%';b.append(l,p);b.onclick=()=>tstep(c.w);box.append(b)});
  const off=st.done||!o.length;$('#tstep').disabled=$('#tfin').disabled=$('#tauto').disabled=off;
  if(off){clearInterval(tim);tim=null;$('#tauto').textContent='Auto'}}
function tstep(w){const st=TS;if(!st||st.done||!st.opts.length)return;
  const c=w?st.opts.find(x=>x.w==w):draw(st.opts);
  st.msg=`Picked ${c.w=='</s>'?'(end of sentence)':'"'+c.w+'"'}, which had a ${(c.p*100).toFixed(1)}% chance${w?' (you chose it)':''}.`;
  gpush(st,c.w);st.opts=st.done?[]:gopts(st);tshow()}
$('#tstart').onclick=()=>{clearInterval(tim);tim=null;$('#tauto').textContent='Auto';$('#tview').hidden=false;
  if(!idx.N){TS=null;$('#tout').textContent='';$('#topts').innerHTML='';$('#tinfo').textContent='Teach me something first, then there will be something to predict from.';$('#tstep').disabled=$('#tfin').disabled=$('#tauto').disabled=true;return}
  TS=gstate($('#tp').value.trim(),+$('#temp').value);TS.opts=gopts(TS);tshow()};
$('#tp').onkeydown=e=>{if(e.key=='Enter')$('#tstart').click()};
$('#tstep').onclick=()=>tstep();
$('#tfin').onclick=()=>{for(let i=0;i<100&&TS&&!TS.done&&TS.opts.length;i++)tstep()};
$('#tauto').onclick=()=>{if(tim){clearInterval(tim);tim=null;$('#tauto').textContent='Auto';return}$('#tauto').textContent='Pause';tim=setInterval(()=>tstep(),700)};
$('#t-chat').onclick=()=>show('chat');$('#t-teach').onclick=()=>show('teach');
$('#go').onclick=send;
inp.onkeydown=e=>{if(e.key=='Enter'&&!e.shiftKey){e.preventDefault();send()}};
inp.oninput=()=>{inp.style.height='auto';inp.style.height=Math.min(inp.scrollHeight,120)+'px'};
$('#learn').onclick=()=>{const v=$('#txt').value;if(!v.trim())return tmsg('Write or paste something first.');
  const [n,r]=add(parse(v,3));tmsg(msgL(n,r));if(n||r)$('#txt').value=''};
$('#fi').onchange=e=>{files([...e.target.files]);e.target.value=''};
addEventListener('dragover',e=>e.preventDefault());
addEventListener('drop',e=>{e.preventDefault();files([...e.dataTransfer.files])});
$('#up').onclick=()=>upload();
$('#pill').onclick=async()=>{await load();sst(`Synced. The community has taught me ${comm.length} things.`)};
$('#sv').onclick=()=>{const v=$('#tok').value.trim();if(!v)return;S(sessionStorage,'sprout.tk',v);S(localStorage,'sprout.tk',$('#rem').checked?v:null);$('#tok').value='';sst('Token saved. You can share now.')};
$('#cl').onclick=()=>{S(sessionStorage,'sprout.tk',null);S(localStorage,'sprout.tk',null);sst('Token removed from this browser.')};

(async()=>{build();await load();
  say(idx.N?`Hi, I'm Sprout. I've learned ${idx.N} things from you and the community. Ask me something.`:"Hi, I'm Sprout. I start with no knowledge at all. Open the Teach menu to give me facts or .txt files, then come back and ask me questions.",'bot',idx.N?null:['Open Teach',()=>show('teach')])})();
</script>
