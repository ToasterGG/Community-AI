gen=(q,T)=>{let r=null;try{r=S2.answer(q)}catch(e){console.warn('S2',e)}
  if(r&&!r.soft)return use(q,r);
  const g=pick(q,T);return S2.choose(r,g)=='r'?use(q,r,g):g};
const pick=(q,T)=>{const k=+(P('lmk')||6);if(!S2.lmReady()||k<2||P('lm.use')==='0')return _gen(q,T);
  const H0=[...HIST],U0=new Set(USED),c=[];for(let i=0;i<k;i++){const g=_gen(q,T);if(g)c.push(g);HIST=[...H0];USED=new Set(U0)}
  if(!c.length)return null;const sure=c.filter(g=>!g.guessed),pool=sure.length?sure:c,best=pool.map(g=>[S2.lmFluency(g.text),g]).sort((a,b)=>a[0]-b[0])[0][1];
  HIST=[...H0,{q,a:best.text}].slice(-6);return best};
const use=(q,r,g)=>{if(S(localStorage,'sprout.why')!=='1'&&(r.conf??1)>=.7)r.note=null;if(S(localStorage,'sprout.why')==='1'&&S2.trace.length)r.note=(r.note?r.note+'\n':'')+'Thought: '+S2.trace.map(([a,c])=>a+' → '+c).join(' · ');
  try{const e={q,a:r.plain||r.text};HIST=g?[...HIST.slice(0,-1),e]:[...HIST,e].slice(-6)}catch{}return r};
show=t=>{document.querySelector('nav').style.setProperty('--i',['chat','teach','brain','know','settings'].indexOf(t));['chat','teach','brain','know','settings'].forEach(x=>{$('#'+x).hidden=x!=t;$('#t-'+x).setAttribute('aria-selected',x==t)});if(t=='chat')inp.focus();if(t=='brain')ui();if(t=='know')know();if(t=='settings')sets()};
$('#t-brain').onclick=()=>show('brain');$('#t-know').onclick=()=>show('know');$('#t-settings').onclick=()=>show('settings');
const P=k=>S(localStorage,'sprout.'+k),setP=(k,v)=>S(localStorage,'sprout.'+k,String(v));
function applyUI(){const d=document.documentElement,g=(k,x)=>P('ui.'+k)||x;d.dataset.theme=g('theme','auto');d.dataset.anim=g('anim','auto');d.dataset.compact=g('compact','0');d.dataset.bg=g('bg','1');
  d.style.setProperty('--fs',g('font','16')+'px');d.style.setProperty('--w',{narrow:'600px',normal:'760px',wide:'1040px'}[g('width','normal')]||'760px');
  const a=P('ui.accent');if(/^#[0-9a-f]{6}$/i.test(a||'')){const n=parseInt(a.slice(1),16),l=(.299*(n>>16)+.587*(n>>8&255)+.114*(n&255))/255;d.style.setProperty('--leaf',a);d.style.setProperty('--on',l>.6?'#04120a':'#fff')}else{d.style.removeProperty('--leaf');d.style.removeProperty('--on')}}
function loadPrefs(){document.querySelectorAll('[data-pref]').forEach(el=>{const v=P(el.dataset.pref);if(v!=null){if(el.type=='checkbox')el.checked=v=='1';else el.value=v}})}
document.querySelectorAll('[data-pref]').forEach(el=>{el.oninput=el.onchange=()=>{setP(el.dataset.pref,el.type=='checkbox'?(el.checked?1:0):el.value);applyUI()}});
applyUI();
$('#gz').onclick=()=>{if(confirm('Erase everything Sprout 2.0 stored here (memories, graph, trained net, settings)? This cannot be undone.')){['sprout.gh.cfg','sprout.gh.tok','sprout.gh.q','sprout.tomb','sprout.swear','sprout.why','sprout.name',...['ui.theme','ui.accent','ui.font','ui.width','ui.anim','ui.bg','ui.compact','ui.speed','sass','energy','swearlvl','detail'].map(k=>'sprout.'+k)].forEach(k=>localStorage.removeItem(k));indexedDB.deleteDatabase('sprout2');location.reload()}};
/* Chat extras: streaming replies, copy, retry, new chat */
const _say=say;let LASTU='',LASTB=null;
say=(t,w,a,n,fb)=>{const d=_say(t,w,a,n,fb);if(w==='me')LASTU=t;
  if(w==='bot'&&t){const full=t,tn=d.firstChild,c=document.createElement('button');c.className='cp';c.textContent='Copy';c.onclick=()=>navigator.clipboard&&navigator.clipboard.writeText(full).then(()=>{c.textContent='Copied';setTimeout(()=>c.textContent='Copy',1200)});d.append(c);LASTB=d;
    const cps={instant:0,fast:6,natural:2}[P('ui.speed')||'natural'];
    if(cps&&tn&&tn.nodeType==3&&document.documentElement.dataset.anim!=='off'&&!(matchMedia('(prefers-reduced-motion:reduce)').matches&&document.documentElement.dataset.anim=='auto')){d.classList.add('streaming');tn.nodeValue='';let i=0;const lg=$('#log'),tick=()=>{i=Math.min(full.length,i+cps+(Math.random()<.2?1:0));tn.nodeValue=full.slice(0,i);lg.scrollTop=lg.scrollHeight;if(i<full.length)setTimeout(tick,/[.!?]\s?$/.test(full.slice(0,i))?150:18);else d.classList.remove('streaming')};tick()}}
  return d};
const retry=()=>{if(!LASTU||!LASTB||!LASTB.isConnected)return;LASTB.remove();const t=_say('','bot typing');t.innerHTML='<i></i><i></i><i></i>';
  setTimeout(()=>{t.remove();const g=gen(LASTU,Math.min(1.6,+$('#temp').value+.3));if(g)say(g.text,'bot',null,g.guessed?'This response had guesses included.':g.note||null,g.nofb?null:{q:LASTU.slice(0,300),s2:g.s2,text:g.plain||g.text,src:g.src,cont:g.cont,prevq:g.prevq})},350)};
{const r=document.createElement('button');r.id='rg';r.textContent='↻ Retry';r.onclick=retry;$('.tune').append(r);
 const n=document.createElement('button');n.id='nc';n.textContent='New chat';n.onclick=()=>{$('#log').innerHTML='';try{HIST=[];USED=new Set()}catch{}LASTB=null;say("Fresh start. What's up?",'bot')};document.querySelector('header').insertBefore(n,$('#pill'))}
function know(){const q=$('#kq').value.trim(),ul=$('#kl');ul.innerHTML='';
  S2.ents(q.toLowerCase()).slice(0,20).forEach(n=>{const d=S2.entity(n);ul.append(li(n,[...d.own.slice(0,6).map(g=>`${g.a} ${g.r} ${g.b}`),d.anc.length?'inherits: '+d.anc.map(a=>a[0]).join(' → '):''].filter(Boolean).join(' · ')))});
  if(q)S2.search(q,['semantic'],5).forEach(h=>ul.append(li(h.d.a||h.d.text,`${h.d.src} · confidence ${Math.round(h.d.conf*100)}%`)));
  if(!ul.children.length)ul.append(li('Nothing found yet.'))}
$('#kq').oninput=know;
const gm=m=>{$('#gm').textContent=m},err=e=>gm(GH.clean(e&&e.message||e)),files=()=>[...$('#gf').querySelectorAll('input:checked')].map(i=>i.value);
function sets(){loadPrefs();const c=GH.cfg(),f=$('#gf');$('#gow').value=c.owner||'';$('#gr').value=c.repo||'';$('#gb').value=c.branch||'';$('#gn').value=localStorage.getItem('sprout.name')||'';
  if(!f.children.length)GH.ALL.forEach(n=>{const l=document.createElement('label'),i=document.createElement('input');l.className='hint';i.type='checkbox';i.checked=true;i.value=n;l.append(i,' '+n+'.json   ');f.append(l)});
  gm((GH.has()?'Token loaded for this session.':GH.stored()?'An encrypted token is stored: enter your passphrase and press Unlock.':'No token loaded.')+(localStorage.getItem('sprout.gh.q')?' A push is queued.':''))}
$('#gs').onclick=async()=>{try{if($('#gk').checked&&$('#gt').value&&!$('#gp').value)throw new Error('Enter a passphrase to remember the token.');GH.setCfg({owner:$('#gow').value.trim(),repo:$('#gr').value.trim(),branch:$('#gb').value.trim()});localStorage.setItem('sprout.name',$('#gn').value.slice(0,60));
  if($('#gt').value){await GH.setToken($('#gt').value,$('#gk').checked?$('#gp').value:'');$('#gt').value='';$('#gp').value=''}gm('Saved. '+(GH.has()?'Token loaded for this session.':'No token loaded.'))}catch(e){err(e)}};
$('#gu').onclick=async()=>{try{await GH.unlock($('#gp').value);$('#gp').value='';gm('Token unlocked for this session.')}catch{gm('Wrong passphrase, or the stored data is damaged.')}};
$('#gx').onclick=()=>{GH.forget();$('#gt').value='';$('#gp').value='';gm('Credentials removed from this tab and this browser.')};
const sync=async push=>{const f=files();if(!f.length)return gm('Pick at least one file.');gm(push?'Pushing…':'Pulling…');
  try{const o=await(push?GH.push(f):GH.pull(f));localStorage.removeItem('sprout.gh.q');applyUI();loadPrefs();$('#sw').checked=localStorage.getItem('sprout.swear')==='1';$('#sy').checked=localStorage.getItem('sprout.why')==='1';gm(`${push?'Pushed':'Pulled'}: ${o.added} new, ${o.updated} updated, ${o.conflicts} conflicting item(s) where your newer local version was kept.`+(push?` Wrote ${o.written.length} file(s).`:''));ui()}
  catch(e){if(e.offline&&push){localStorage.setItem('sprout.gh.q',JSON.stringify(f));gm('You are offline. The push is queued and will run when you are back online, if the token is still loaded.')}else err(e)}};
$('#gl').onclick=()=>sync(0);$('#gh').onclick=()=>sync(1);
addEventListener('online',()=>{const q=localStorage.getItem('sprout.gh.q');if(q&&GH.has()){localStorage.removeItem('sprout.gh.q');GH.push(JSON.parse(q)).then(()=>gm('Queued push finished.')).catch(err)}});
const li=(txt,sub,fn,ed)=>{const l=document.createElement('li'),s=document.createElement('span');s.textContent=txt;if(sub){const m=document.createElement('small');m.textContent=sub;s.append(m)}l.append(s);if(ed){const b=document.createElement('button');b.textContent='Edit';b.onclick=ed;l.append(b)}if(fn){const b=document.createElement('button');b.textContent='Remove';b.onclick=fn;l.append(b)}return l};
function ui(){const m=S2.mem;$('#b1').textContent=Object.values(m).reduce((a,b)=>a+b.length,0);$('#b2').textContent=S2.G.length;$('#b3').textContent=new Set(S2.G.flatMap(g=>[g.a,g.b])).size;
  const tr=$('#trace');tr.innerHTML='';(S2.trace.length?S2.trace:[['Waiting','Send Sprout a message and its stages show up here.']]).forEach(([a,b])=>tr.append(li(a,b)));
  const ty=$('#bt').value,ul=$('#bl'),q=$('#bq').value.trim().toLowerCase();ul.innerHTML='';const items=q?(ty=='graph'?S2.G.filter(g=>`${g.a} ${g.r} ${g.b}`.includes(q)):S2.search(q,[ty],40).map(x=>x.d)):(ty=='graph'?S2.G:m[ty]);
  (q?items:items.slice(-40).reverse()).forEach(x=>ul.append(li(ty=='graph'?`${x.a} ${x.r} ${x.b}`:x.text.slice(0,200),`${x.src} · seen ×${x.n}`+(x.hist&&x.hist.length?' · corrected before':'')+(x.u?' · '+x.u:''),()=>{S2.drop(ty,x.id);ui()},ty=='graph'?null:()=>{const v=prompt('Edit this memory',x.text);if(v&&S2.fix(ty,x.id,v))ui()})));
  if(!items.length)ul.append(li('Nothing here yet.'))}
$('#bt').onchange=ui;$('#bq').oninput=ui;
$('#sy').checked=S(localStorage,'sprout.why')==='1';$('#sy').onchange=e=>S(localStorage,'sprout.why',e.target.checked?'1':'0');
$('#bE').onclick=()=>{const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([S2.exportAll()],{type:'application/json'}));a.download='sprout-brain-backup.json';a.click();URL.revokeObjectURL(a.href)};
$('#bI').onchange=async e=>{const f=e.target.files[0];e.target.value='';if(!f)return;try{$('#bmb').textContent=`Restored ${S2.importAll(await f.text())} new item(s).`;ui()}catch(err){$('#bmb').textContent='Could not read that backup: '+err.message}};
$('#sw').checked=S(localStorage,'sprout.swear')==='1';$('#sw').onchange=e=>S(localStorage,'sprout.swear',e.target.checked?'1':'0');
$('#bx').onclick=()=>S2.cancel();
let WP=null;$('#wq').onkeydown=e=>{if(e.key=='Enter')$('#wb').click()};
$('#wb').onclick=async()=>{const m=$('#wm'),ul=$('#wl');ul.innerHTML='';$('#wk').hidden=true;m.textContent='Fetching…';
  try{WP=await S2.wiki($('#wq').value);WP.sentences.forEach((s,i)=>{const l=document.createElement('li'),c=document.createElement('input'),t=document.createElement('span');c.type='checkbox';c.checked=true;c.dataset.i=i;t.textContent=s;l.append(c,t);ul.append(l)});$('#wk').hidden=false;m.textContent=WP.title+': untick anything you do not want Sprout to learn.'}catch(e){m.textContent=e.message}};
$('#wk').onclick=()=>{const p=[...$('#wl').querySelectorAll('input:checked')].map(c=>WP.sentences[+c.dataset.i]);if(!p.length)return;const r=S2.learnWeb(WP,p);
  $('#wm').textContent=`Learned ${r.n} new sentence(s)`+(r.l?` and a link (${WP.title} is a …)`:'')+'. Ask Sprout about it.';$('#wl').innerHTML='';$('#wk').hidden=true;ui()};
$('#b0').onclick=()=>$('#bf').onchange({target:{files:[document.getElementById('seed').textContent],value:''}});
$('#bf').onchange=async e=>{const f=e.target.files[0];e.target.value='';if(!f)return;const bp=$('#bp'),bs=$('#bs');bp.hidden=false;$('#bx').disabled=false;bs.textContent='Reading file…';
  try{const sum=await S2.importText(await(f.text?f.text():f),(p,s)=>{bp.value=p;bs.textContent=`${Math.round(p*100)}% · ${s.ok} imported · ${s.dup} duplicates · ${s.bad} malformed`});
    bs.textContent=S2.fmt(sum)+' Training intent net and word embeddings…';await S2.train();await S2.embed();bs.textContent=S2.fmt(sum)+' Training the neural language model…';bp.hidden=false;try{await S2.trainLM(p=>{bp.value=p})}catch{}$('#lns').textContent=S2.lmStatus();bs.textContent=S2.fmt(sum);$('#bns').textContent=S2.status()}
  catch(err){bs.textContent='Import failed: '+(err&&err.message||err)}
  bp.hidden=true;$('#bx').disabled=true;ui()};
$('#ba').onclick=async()=>{const v=$('#bi').value,o=$('#bm');if(!v.trim())return;o.textContent='Adding…';try{o.textContent=S2.fmt(await S2.addText(v));$('#bi').value='';ui()}catch(e){o.textContent='Could not add that: '+(e&&e.message||e)}};
$('#bn').onclick=async()=>{$('#bns').textContent='Training…';await S2.train();await S2.embed();$('#bns').textContent=S2.status()};
const _v=vote;vote=(up,fb,row,btn)=>{if(!fb.s2)return _v(up,fb,row,btn);if(row.dataset.v)return;row.dataset.v=up?'1':'0';btn.setAttribute('aria-pressed','true');[...row.children].forEach(x=>x.disabled=true);const n=S2.feedback(fb.s2,up),h=document.createElement('span');h.className='hint';h.textContent=up?'Thanks, I trust that a bit more now.':'Noted, I trust that less now.';row.append(h)};
$('#ln').onclick=async()=>{const bar=$('#lp'),m=$('#lns');bar.hidden=false;bar.value=0;m.textContent='Training in the background…';try{await S2.trainLM(p=>{bar.value=p});m.textContent=S2.lmStatus()}catch(e){m.textContent=e.message}bar.hidden=true};
$('#lt').onclick=()=>{const t=S2.lmSample($('#li').value,+$('#temp').value);$('#lo').textContent=t?($('#li').value.trim()+' '+t):'Train the language model first.'};
S2.init().then(()=>{$('#lns').textContent=S2.lmStatus();ui();$('#bns').textContent=S2.status()});
})();
</script>
