const LP=s=>RC('language_pattern').filter(f=>/^informal for /i.test(f.meaning||'')&&/^\w+$/.test(f.pattern||'')).reduce((a,f)=>a.replace(new RegExp('\\b'+f.pattern+'\\b','gi'),f.meaning.replace(/^informal for /i,'')),s);
function convs(kind,s){const q=new Set(tok(s)),L=RC('conversation_example').filter(f=>(f.intent||'').toLowerCase()==kind&&f.user&&f.sprout);if(!L.length)return null;
  const r=L.map(f=>[jac(q,new Set(tok(f.user)))+Math.random()*.01,f]).sort((a,b)=>b[0]-a[0])[0];return r[0]<.25&&!['greeting','social','joke'].includes(kind)?null:r[1]}
/* Intent network: hashed word + character-trigram features -> 20 tanh units -> softmax over intents. Random init, plain SGD, no pretrained weights. */
const LAB=['greeting','social','question','teach','correction','explain','instruction','joke','emotion','statement'],IN=256,H=20;
const gauss=()=>Math.sqrt(-2*Math.log(Math.random()||1e-9))*Math.cos(6.2831853*Math.random());
function initNN(){W1=Float32Array.from({length:IN*H},()=>gauss()*Math.sqrt(1/IN));B1=new Float32Array(H);W2=Float32Array.from({length:H*LAB.length},()=>gauss()*Math.sqrt(1/H));B2=new Float32Array(LAB.length)}
const hx=s=>{let h=2166136261;for(let i=0;i<s.length;i++){h^=s.charCodeAt(i);h=Math.imul(h,16777619)}return(h>>>0)%IN};
const feat=s=>{const l=' '+s.toLowerCase().replace(/[^\p{L}\p{N}'?! ]/gu,'').replace(/(.)\1{2,}/g,'$1$1')+' ',x=new Float32Array(IN);l.split(' ').forEach(w=>w&&(x[hx('w'+w)]+=1));for(let i=0;i<l.length-2;i++)x[hx(l.slice(i,i+3))]+=.5;const n=Math.hypot(...x)||1;return x.map(v=>v/n)};
function fwd(x){const L=LAB.length,h=new Float32Array(H),o=new Float32Array(L);for(let j=0;j<H;j++){let s=B1[j];for(let i=0;i<IN;i++)if(x[i])s+=x[i]*W1[i*H+j];h[j]=Math.tanh(s)}let m=-1e9;for(let k=0;k<L;k++){let s=B2[k];for(let j=0;j<H;j++)s+=h[j]*W2[j*L+k];o[k]=s;if(s>m)m=s}let z=0;for(let k=0;k<L;k++)z+=o[k]=Math.exp(o[k]-m);for(let k=0;k<L;k++)o[k]/=z;return{h,o}}
function step(x,y,lr){const{h,o}=fwd(x),L=LAB.length,d2=new Float32Array(L),d1=new Float32Array(H);for(let k=0;k<L;k++)d2[k]=o[k]-(k==y?1:0);
  for(let j=0;j<H;j++){let g=0;for(let k=0;k<L;k++)g+=d2[k]*W2[j*L+k];d1[j]=g*(1-h[j]*h[j])}
  for(let j=0;j<H;j++)for(let k=0;k<L;k++)W2[j*L+k]-=lr*d2[k]*h[j];for(let k=0;k<L;k++)B2[k]-=lr*d2[k];
  for(let i=0;i<IN;i++)if(x[i])for(let j=0;j<H;j++)W1[i*H+j]-=lr*d1[j]*x[i];for(let j=0;j<H;j++)B1[j]-=lr*d1[j]}
function nnPredict(s){if(!NNinfo.ok||!W1)return null;const o=fwd(feat(s)).o;let b=0;o.forEach((v,k)=>{if(v>o[b])b=k});return{l:LAB[b],p:o[b]}}
const trainSet=()=>[...RC('conversation_example').filter(f=>f.user&&LAB.includes((f.intent||'').toLowerCase())).map(f=>({t:f.user,l:f.intent.toLowerCase()})),...XD.filter(e=>LAB.includes(e.l))];
async function train(){const ex=trainSet();if(ex.length<30){NNinfo={n:ex.length,acc:0,ok:0};return NNinfo}
  initNN();const sh=[...ex].sort(()=>Math.random()-.5),cut=Math.floor(sh.length*.8),pre=a=>a.map(e=>[feat(e.t),LAB.indexOf(e.l)]),A=pre(sh.slice(0,cut)),T=pre(sh.slice(cut)),B=T.length?T:A;
  const go=async(D,n)=>{for(let ep=0;ep<n;ep++){D.sort(()=>Math.random()-.5).forEach(([x,y])=>step(x,y,.25));if(ep%10==9)await new Promise(r=>setTimeout(r))}};
  await go(A,120);const acc=B.filter(([x,y])=>{const o=fwd(x).o;return o.indexOf(Math.max(...o))==y}).length/B.length;await go([...A,...T],30);
  NNinfo={n:ex.length,acc,ok:acc>=.6&&T.length>=6?1:0};put('model',{id:'intent',w1:[...W1],b1:[...B1],w2:[...W2],b2:[...B2],info:NNinfo});return NNinfo}
/* Feedback: thumbs change the trust stored on the exact links / memory behind an answer; links under 20% are ignored by reasoning */
function feedback(ref,up){let n=0;const cl=v=>Math.max(0,Math.min(1,v));(ref.ed||[]).forEach(id=>{const g=G.find(x=>x.id==id);if(g){g.conf=cl(g.conf+(up?.05:-.15));g[up?'up':'dn']=(g[up?'up':'dn']||0)+1;put('graph',g);n++}});
  if(ref.mem){const m=mem[ref.ty].find(x=>x.id==ref.mem);if(m){m.conf=cl(m.conf+(up?.05:-.15));m.imp=Math.max(.05,Math.min(1,m.imp+(up?.1:-.2)));put(ref.ty,m);n++}}dirty=1;return n}
/* Typed brain input: full records go through the importer (source: you); plain lines become links or facts */
async function addText(text,prog){if(/\[[A-Z_]+\]/.test(text))return importText(text,prog,'user');
  const sum={links:0,facts:0,dup:0,replaced:0,bad:0};
  text.split('\n').map(l=>l.trim()).filter(l=>l&&!l.startsWith('#')).forEach(l=>{const qa=l.split(/\s*=>\s*/);
    if(qa.length==2&&qa[0]&&qa[1]){const x=remember('semantic',qa[0]+' '+qa[1],{src:'user',q:qa[0],a:qa[1],idx:l,conf:.9});x.dup?sum.dup++:sum.facts++;return}
    const p=parseT(l);if(p){const x=link(p.a,p.r,p.b,{src:'user',conf:.9});if(!x)return sum.bad++;x.dup?sum.dup++:(sum.links++,x.replaced&&sum.replaced++);return}
    const x=remember('semantic',l,{src:'user',conf:.8,fuzzy:1});x?(x.dup?sum.dup++:sum.facts++):sum.bad++});
  flush();dirty=1;return sum}
const fmt=s=>s.via?`${s.cancelled?'Cancelled':'Done'} (${s.via}). ${s.ok} imported (${Object.entries(s.by).map(([k,v])=>k.toLowerCase()+' '+v).join(', ')||'none'}), ${s.dup} duplicates skipped, ${s.bad} malformed, ${s.conflict} conflicts with things you taught (yours kept).`+(s.parked?` ${s.parked} reasoning-rule record(s) are stored but not used yet.`:''):`Added ${s.links} link(s) and ${s.facts} fact(s)${s.replaced?`, ${s.replaced} replaced an older conflicting link (kept in history)`:''}. ${s.dup} already known, ${s.bad} skipped.`;
const status=()=>`Intent net: ${NNinfo.ok?'active':'not active'} · ${NNinfo.n} training examples · held-out accuracy ${Math.round(NNinfo.acc*100)}% · ${XD.length} of your chat lines saved as rule-labelled examples`;
async function init(){await open();for(const s of ST){const a=await gall(s);if(s=='graph')G.push(...a);else a.forEach(m=>{mem[s].push(m);KS.add(s+'|'+nk(m.text))})}for(const m of await gall('model')){if(m.id=='intentdata')XD=m.d||[];if(m.id=='intent'&&m.w1)try{initNN();W1.set(m.w1);B1.set(m.b1);W2.set(m.w2);B2.set(m.b2);NNinfo=m.info}catch{NNinfo={n:0,acc:0,ok:0}}}dirty=1}
return{init,answer,importText,train,feedback,addText,fmt,status,remember,fix,drop,link,prove,search,intent,mem,G,get trace(){return TR},cancel:()=>{cancel=1;if(W){W.terminate();W=null;WR&&WR()}},wsrc:WSRC,flush}})();
